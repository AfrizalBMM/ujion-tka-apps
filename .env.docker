APP_NAME="Ujion TKA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Untuk instance publik (tunnel): APP_ENV=production, APP_DEBUG=false, APP_URL=https://tka-ujion.com
APP_URL=http://localhost:8080

# Port webserver & Vite di host (default 8080/5173; ubah jika bentrok dengan service lain)
# HTTP_PORT=8088
# VITE_PORT=5174

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tka-ujion
DB_USERNAME=ujion
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Untuk instance publik via tunnel (HTTPS), set true:
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
# Jika akses via domain publik, ganti host/scheme:
# PUSHER_HOST=tka-ujion.com
# PUSHER_SCHEME=https

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev: http://localhost:8080/auth/google/callback — Publik: https://tka-ujion.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

VITE_APP_NAME="${APP_NAME}"

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

ADMIN_WHATSAPP=

# WhatsApp Gateway webhook (POST /api/wa-webhook).
# WAJIB diisi (string acak panjang, mis. hasil `php artisan tinker --execute="echo bin2hex(random_bytes(32));"`).
# Webhook menolak semua request jika key kosong.
WA_WEBHOOK_KEY=
WA_WEBHOOK_DEBUG=false

# WhatsApp Gateway (Node.js) berjalan di host Windows, bukan di dalam Docker:
WA_GATEWAY_URL=http://host.docker.internal:3000
WA_SENDER_ID=tka-admin
